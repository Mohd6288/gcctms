# Copy to .env.local for local dev (values below match `supabase start`'s local defaults).
# Real values live in Vercel/Supabase platform environment settings — never commit secrets.

# Public (safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public — this app's own origin, used to build the QR code / verify link
# baked into each issued certificate PDF (Phase 8, see modules/certification/service.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — bypasses RLS, never expose to the client (see lib/supabase/admin.ts)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — Drizzle's direct Postgres connection (see src/db/index.ts)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Server-only — HMAC key for employees.national_id_hash (Phase 1, see database-schema.md)
NATIONAL_ID_HASH_KEY=

# Dev-only convenience, never set outside your local .env.local — the base32
# secret from a local test account's /mfa/enroll "enter manually" text.
# Lets `npm run totp` print the current code without re-pasting the secret
# each login. Never a real user's secret, never committed.
DEV_TOTP_SECRET=

# DEV/STAGING-ONLY — comma-separated list of test account emails that skip
# MFA entirely (see modules/platform/auth/shared.ts's isMfaBypassEmail).
# Public because the sign-in form needs it before a session exists yet, but
# it only ever names fake test accounts, never real ones. MUST NOT be set on
# a real production environment — see docs/runbook.md.
NEXT_PUBLIC_MFA_BYPASS_EMAILS=
